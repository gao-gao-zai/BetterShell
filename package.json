{
  "name": "@gao-gao-zai/better-shell-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "tsc -b --clean",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration:windows": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "check:packages": "pnpm exec publint packages/better-shell-terminal && pnpm exec publint packages/better-shell-tools",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
